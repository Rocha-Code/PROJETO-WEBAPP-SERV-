<%- include('../partials/header') %>

<h1><%= tituloPagina %></h1>

<% if (erro) { %><p class="msg erro"><%= erro %></p><% } %>

<form action="<%= acao %>" method="POST" class="form">
  <label>Título *
    <input type="text" name="titulo" value="<%= servico.titulo || '' %>" required>
  </label>
  <label>Descrição
    <textarea name="descricao" rows="4"><%= servico.descricao || '' %></textarea>
  </label>
  <label>Categoria *
    <select name="categoriaId" required>
      <option value="">Selecione...</option>
      <% categorias.forEach(function(c) { %>
        <option value="<%= c.id %>" <%= Number(servico.categoriaId) === Number(c.id) ? 'selected' : '' %>>
          <%= c.nome %>
        </option>
      <% }) %>
    </select>
  </label>
  <label>Duração (minutos) *
    <input type="number" name="duracaoMinutos" min="1" value="<%= servico.duracaoMinutos || '' %>" required>
  </label>
  <label>Preço (R$) *
    <input type="text" name="preco" value="<%= servico.preco !== undefined ? servico.preco : '' %>" required>
  </label>
  <button type="submit" class="btn">Salvar</button>
</form>

<p><a href="/profissional/servicos">← Voltar</a></p>

<%- include('../partials/footer') %>